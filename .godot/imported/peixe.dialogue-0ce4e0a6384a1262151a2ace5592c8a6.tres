"tags": PackedStringArray(),
"text": "Todo mundo que eu conheço no rio está fraco por causa disso. Só eu sobrevivi da minha família...",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Todo mundo que eu conheço no rio está fraco por causa disso. Só eu sobrevivi da minha família...",
