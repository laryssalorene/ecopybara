"character_replacements": Array[Dictionary]([]),
"id": "14",
"next_id": "16",
"notes": "",
"tags": PackedStringArray(),
"text": "Já vi plástico até no meu anzol, capivara! O rio tá todo sujo, não dá pra pescar direito.",
