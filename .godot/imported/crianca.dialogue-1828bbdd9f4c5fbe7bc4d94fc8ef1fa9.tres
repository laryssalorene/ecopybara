},
"17": {
"character": "Criança",
"character_replacements": Array[Dictionary]([]),
"id": "17",
"next_id": "19",
"notes": "",
"tags": PackedStringArray(),
"text": "E o pior é que o povo continua jogando mais lixo na água. Eu falo, mas parece que ninguém ouve.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "E o pior é que o povo continua jogando mais lixo na água. Eu falo, mas parece que ninguém ouve.",
"type": &"dialogue"
},
"19": {
"character": "Capivara",
"character_replacements": Array[Dictionary]([]),
"id": "19",
"next_id": "20",
"notes": "",
"tags": PackedStringArray(),
"text": "A água tá ficando turva e cheia de plásticos, garrafas e outros restos... Isso prejudica todo o ecossistema.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "A água tá ficando turva e cheia de plásticos, garrafas e outros restos... Isso prejudica todo o ecossistema.",
"type": &"dialogue"
},
"20": {
"character": "Criança",
"character_replacements": Array[Dictionary]([]),
"id": "20",
"next_id": "22",
"notes": "",
"tags": PackedStringArray(),
"text": "Eu vou ter que fazer alguma coisa. Se o pessoal não se mexer, o rio vai acabar virando um lugar de sujeira.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Eu vou ter que fazer alguma coisa. Se o pessoal não se mexer, o rio vai acabar virando um lugar de sujeira.",
"type": &"dialogue"
},
"22": {
"character": "Capivara",
"character_replacements": Array[Dictionary]([]),
"id": "22",
"next_id": "23",
"notes": "",
"tags": PackedStringArray(),
"text": "Eu sei que a galera não se importa muito, mas é a nossa responsabilidade ensinar o povo a cuidar do rio.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Eu sei que a galera não se importa muito, mas é a nossa responsabilidade ensinar o povo a cuidar do rio.",
