"character_replacements": Array[Dictionary]([]),
"id": "26",
"next_id": "28",
"notes": "",
"tags": PackedStringArray(),
"text": "Mas, eu tenho medo de que, depois dessa limpeza, o pessoal vá esquecer e começar tudo de novo.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Mas, eu tenho medo de que, depois dessa limpeza, o pessoal vá esquecer e começar tudo de novo.",
