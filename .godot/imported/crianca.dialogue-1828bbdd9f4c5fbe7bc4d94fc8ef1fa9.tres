"character_replacements": Array[Dictionary]([]),
"id": "16",
"next_id": "17",
"notes": "",
"tags": PackedStringArray(),
"text": "Esse lixo não vai desaparecer sozinho, menino. O banzeiro só trouxe mais sujeira pras margens.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Esse lixo não vai desaparecer sozinho, menino. O banzeiro só trouxe mais sujeira pras margens.",
