"character_replacements": Array[Dictionary]([]),
"id": "23",
"next_id": "25",
"notes": "",
"tags": PackedStringArray(),
"text": "Vou reunir o povo da vila, capivara! Se a gente se juntar, dá pra limpar tudo rapidinho.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Vou reunir o povo da vila, capivara! Se a gente se juntar, dá pra limpar tudo rapidinho.",
"type": &"dialogue"
},
"25": {
"character": "Capivara",
"character_replacements": Array[Dictionary]([]),
"id": "25",
"next_id": "26",
"notes": "",
"tags": PackedStringArray(),
"text": "Vamo juntar as forças da vila! Se cada um cuidar do seu pedacinho de rio, a coisa melhora rapidinho.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Vamo juntar as forças da vila! Se cada um cuidar do seu pedacinho de rio, a coisa melhora rapidinho.",
"type": &"dialogue"
},
"26": {
