"character_replacements": Array[Dictionary]([]),
"id": "28",
"next_id": "29",
"notes": "",
"tags": PackedStringArray(),
"text": "Eu vou te ajudar, pode contar comigo. Juntos, a gente vai mostrar pra todo mundo que a natureza precisa de cuidado!",
